# Variáveis de ambiente do docker-compose.
# Copie para .env e ajuste (o .env não é versionado):
#   cp .env.example .env
# Ou rode direto com os valores de exemplo:
#   docker compose --env-file .env.example up -d --build
#
# ATENÇÃO: valores abaixo são apenas para desenvolvimento local.

# ---------- PostgreSQL ----------
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_dev_password
POSTGRES_PORT=5432

# ---------- RabbitMQ ----------
# Usados em uma URI AMQP: evite caracteres especiais (ou use-os URL-encoded).
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=orders_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- pgAdmin ----------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_dev_password
PGADMIN_PORT=5050

# ---------- Jaeger (tracing) ----------
JAEGER_UI_PORT=16686

# ---------- Aplicações ----------
API_PORT=8080
WEB_PORT=3000
ASPNETCORE_ENVIRONMENT=Production
# Tempo entre "Processando" e "Finalizado" (hh:mm:ss)
ORDER_COMPLETION_DELAY=00:00:05
